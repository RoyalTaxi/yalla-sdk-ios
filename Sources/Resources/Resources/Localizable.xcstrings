    "intro_onboarding_1_title": {
      "extractionState": "manual",
      "localizations": {
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tez va qulay"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast and Convenient"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро и удобно"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тез ва қулай"
          }
        }
      }
    },
    "intro_onboarding_1_description": {
      "extractionState": "manual",
      "localizations": {
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safarni buyurtma qiling — Yalla bir necha soniyada eng yaqin haydovchini topadi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order a ride — Yalla finds the nearest driver in seconds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закажите поездку — Yalla мгновенно найдёт ближайшего водителя."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Сафарни буюртма қилинг — Yalla бир неча сонияда энг яқин ҳайдовчини топади."
          }
        }
      }
    },
    "intro_onboarding_2_title": {
      "extractionState": "manual",
      "localizations": {
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ishonchli haydovchilar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted Drivers"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надёжные водители"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ишончли ҳайдовчилар"
          }
        }
      }
    },
    "intro_onboarding_2_description": {
      "extractionState": "manual",
      "localizations": {
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalladagi har bir haydovchi tekshiruvdan o'tgan va yuqori reytingga ega."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Yalla driver is verified and highly rated."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый водитель Yalla проверен и имеет высокий рейтинг."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Yallaдаги ҳар бир ҳайдовчи текширувдан ўтган ва юқори рейтингга эга."
          }
        }
      }
    },
    "intro_onboarding_3_title": {
      "extractionState": "manual",
      "localizations": {
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaffof narx"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparent Pricing"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прозрачная цена"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаффоф нарх"
          }
        }
      }
    },
    "intro_onboarding_3_description": {
      "extractionState": "manual",
      "localizations": {
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safar boshlanishidan oldin narxni bilib oling — yashirin to'lovlar va kutilmagan xarajatlarsiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know the cost before your trip — no hidden fees or surprises."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте стоимость до начала поездки — без скрытых платежей и сюрпризов."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Сафар бошланишидан олдин нархни билиб олинг — яширин тўловлар ва кутилмаган харажатлар йўқ."
          }
        }
      }
    },
    "intro_onboarding_4_title": {
      "extractionState": "manual",
      "localizations": {
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
