        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Қулай тўлов"
          }
        }
      }
    },
    "intro_onboarding_4_description": {
      "extractionState": "manual",
      "localizations": {
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "O'zingizga qulay usulda to'lang — karta yoki naqd pul bilan. Yalla bilan hammasi oson."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay your way — by card or cash. It's simple with Yalla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платите, как удобно — картой или наличными. С Yalla всё просто."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ўзингизга қулай усулда тўланг — карта ёки нақд пул билан. Yalla билан ҳаммаси осон."
          }
        }
      }
